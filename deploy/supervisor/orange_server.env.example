# =============================================================================
# OrangeServer Web 进程环境变量（supervisor 加载）
# =============================================================================
# 维护者参考：新部署优先使用 systemd 或 Docker Compose。
# 本文件只提供 Supervisor 进程启动参数，不是完整应用配置。
# 数据库、Redis、密钥和数据目录等 OGS_* 仍必须由 root-only 环境文件完整注入。
#
# 使用方法：
#   1) 复制本文件为 /etc/supervisor/orange_server.env
#   2) 在 /etc/supervisor/supervisord.conf 的 [supervisord] 段加：
#        environment=OGS_HOME="/opt/orangeserver/app/backend",OGS_PYTHON="/opt/orangeserver/venv/bin/python",OGS_BIND_HOST="127.0.0.1",OGS_PORT="28000"
#      或者更优雅的：在 supervisord 启动脚本里 source 本文件：
#        . /etc/supervisor/orange_server.env && supervisord -c ...
#   3) 将完整应用配置保存在 root-only (0600) 环境文件中，并通过发行版的
#      systemd override 注入 supervisord 守护进程。只 source 当前 shell 无效。
#
# REVIEW-15 P1-8：bind_host 默认 127.0.0.1（生产推荐）
#   nginx 反代配置文件在 deploy/nginx/orange_server.conf
#   本地调试时改为 0.0.0.0 + 自行放行 28000 端口
# =============================================================================

# 解释器（使用部署专用 venv）
OGS_PYTHON=/opt/orangeserver/venv/bin/python

# 代码部署根目录（绝对路径）
OGS_HOME=/opt/orangeserver/app/backend

# 监听 host
#   - 生产：127.0.0.1（仅本机回环，由 nginx 反代访问）
#   - 本地调试：0.0.0.0（允许外部直连，无 nginx）
OGS_BIND_HOST=127.0.0.1

# 监听端口（必须与 nginx 反代配置中的 proxy_pass 端口一致）
OGS_PORT=28000

# ============================================================
# 密钥（从 /etc/orange_server/secrets.env 加载，不要写这里）
# ============================================================
# OGS_FLASK_SECRET_KEY=<secrets.token_urlsafe(48)>
# R1-22 (2026-07-01): 推荐 OGS_FERNET_KEYS（多 key 列表，支持 rotation）
#   - 第 1 个 key = 最新（用于加密新数据）
#   - 第 2..N 个 key = 历史（仅用于解密旧数据，触发透明迁移）
#   - 单 key 时 OGS_FERNET_KEY 也可继续使用（兼容路径）
# OGS_FERNET_KEYS=<key1>                # 阶段 1：单 key 起步（推荐）
# OGS_FERNET_KEYS=<key2>,<key1>         # 阶段 2：轮换时把新 key 放最前
# OGS_FERNET_KEYS=<key2>                # 阶段 3：迁移完成后移除旧 key
# OGS_ENV=prod
# ============================================================
